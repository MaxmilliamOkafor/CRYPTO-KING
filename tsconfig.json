{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["config.ts", "background/**/*.ts", "content/**/*.ts", "popup/**/*.ts", "dashboard/**/*.ts", "lib/**/*.ts", "mock/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
