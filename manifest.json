{
  "manifest_version": 3,
  "name": "CRYPTO-KING — Solana Gem Finder & Rug Scanner",
  "version": "2.0.0",
  "description": "Read-only gem finder and rug scanner for Solana meme coins. Spots launches early, follows your holds, warns when the thesis breaks. Risk information only — cannot detect all scams, does not guarantee profits. Not financial advice.",
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://gmgn.ai/*",
    "https://frontend-api-v3.pump.fun/*",
    "https://api.dexscreener.com/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://*.helius-rpc.com/*",
    "https://api.rugcheck.xyz/*",
    "https://api.twitter.com/*",
    "https://lite-api.jup.ag/*",
    "https://api.geckoterminal.com/*",
    "https://rpc.magicblock.app/*"
  ],
  "background": {
    "service_worker": "dist/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://pump.fun/*",
        "https://www.pump.fun/*",
        "https://dextools.io/*",
        "https://www.dextools.io/*"
      ],
      "js": [
        "dist/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "dist/popup/popup.html",
    "default_title": "CRYPTO-KING"
  },
  "options_ui": {
    "page": "dist/dashboard/dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "dist/icons/icon16.png",
    "48": "dist/icons/icon48.png",
    "128": "dist/icons/icon128.png"
  }
}
